Bootstrap: docker
From: nvidia/cuda:13.1.1-cudnn-devel-ubuntu24.04

%post

    # GENERAL
    apt-get update -qq && apt-get -y upgrade
    apt-get install -y --no-install-recommends \
        git ca-certificates cmake curl wget unzip binutils \
        g++ gcc gfortran libafterimage-dev libcfitsio-dev \
        libfftw3-dev libfreetype6-dev libglew-dev libglu-dev \
        libgraphviz-dev libgsl-dev libjpeg-dev liblz4-dev \
        liblzma-dev libpcre2-dev libpng-dev libsqlite3-dev \
        libssl-dev libtbb-dev libtiff-dev libx11-dev \
        libxext-dev libxft-dev libxml2-dev libxpm-dev \
        libxxhash-dev libz-dev libzstd-dev locales make \
        nlohmann-json3-dev python3-dev python3-numpy \
        python-is-python3 xrootd-plugins

    # ROOT CERN
    ROOT_BIN="root_v6.34.00-rc1.Linux-ubuntu24.10-x86_64-gcc14.2.tar.gz"
    mkdir -p /opt/root
    cd /opt/root
    ln -sf /usr/share/zoneinfo/UTC /etc/localtime \
    && wget https://root.cern/download/${ROOT_BIN} \
    && tar -xzvf ${ROOT_BIN} \
    && rm -f ${ROOT_BIN} \
    && echo /opt/root/lib >> /etc/ld.so.conf \
    && ldconfig
    yes | unminimize

    # 3. LibTorch
    # check https://pytorch.org/ for the most suitable url
    wget https://download.pytorch.org/libtorch/cu126/libtorch-shared-with-deps-2.10.0%2Bcu126.zip -O libtorch.zip
    unzip libtorch.zip -d /opt
    rm libtorch.zip    

    # install jana2 here
    git clone https://github.com/JeffersonLab/JANA2 /opt/JANA2
    cd /opt/JANA2
    mkdir build
    cmake -S . -B build -DCMAKE_INSTALL_PREFIX=`pwd`
    cmake --build build --target install -j8
    
    # Final Cleanup
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export ROOTSYS=/opt/root
    export PATH=$ROOTSYS/bin:$PATH
    export PYTHONPATH=$ROOTSYS/lib:$PYTHONPATH
    export CLING_STANDARD_PCH=none

    export LIBTORCH=/opt/libtorch
    export LD_LIBRARY_PATH=$LIBTORCH/lib:$LD_LIBRARY_PATH
    export CMAKE_PREFIX_PATH=$LIBTORCH/share/cmake:$CMAKE_PREFIX_PATH

    export JANA_HOME=/opt/JANA2
    export PATH=$JANA_HOME/bin:$PATH
    export LD_LIBRARY_PATH=$JANA_HOME/lib:$LD_LIBRARY_PATH
    export CMAKE_PREFIX_PATH=$JANA_HOME/cmake/lib/JANA:$CMAKE_PREFIX_PATH


%runscript
    exec /bin/bash